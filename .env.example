# DriveOS environment variables template.
# Copy this file to .env and fill in your actual credentials.
# Do NOT commit your local .env file to Git!

# YouTube API Key for music application features
VITE_YOUTUBE_API_KEY=your_youtube_api_key_placeholder

# Spotify Client ID for Spotify Player integration
VITE_SPOTIFY_CLIENT_ID=your_spotify_client_id_placeholder
SPOTIFY_CLIENT_SECRET=

# TomTom API Key for real-time traffic, automotive routing and POI search
VITE_TOMTOM_API_KEY=your_tomtom_api_key_placeholder

# WeatherAPI.com Key for real-time weather forecasts
VITE_WEATHERAPI_KEY=your_weatherapi_key_placeholder
WEATHERAPI_KEY=
